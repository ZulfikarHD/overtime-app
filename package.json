{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "NODE_OPTIONS='--max-old-space-size=2048' vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp check",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "NODE_OPTIONS='--max-old-space-size=1536' vue-tsc --noEmit",
        "clean:test": "pkill -9 -f '[p]laywright.*launchServer' 2>/dev/null || true; pkill -9 -f '[c]hrome-headless-shell' 2>/dev/null || true"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.43.0",
        "@vueuse/core": "^12.8.2",
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.42",
        "vue-chartjs": "^5.3.4",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "playwright": "^1.63.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vite-plus": "0.3.0",
        "vue-tsc": "^2.2.12"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
